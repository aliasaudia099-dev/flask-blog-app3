<?xml version="1.0" encoding="utf-8"?>
<configuration>
  
  
  <appSettings>
    <!-- Assuming your file is app.py and the variable is app = Flask(__name__) -->
    <add key="WSGI_HANDLER" value="app.app" />
    
    <!-- The root folder where app.py lives (NOT the env folder) -->
    <add key="PYTHONPATH" value="F:\New folder\payroll-system-2025-main\payroll-system-2025-main" />
    
    <!-- Uncommented and pointing to a real file -->
    <add key="WSGI_LOG" value="F:\New folder\payroll-system-2025-main\payroll-system-2025-main\wfastcgi.log" />
  </appSettings>
</configuration>